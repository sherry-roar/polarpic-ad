#################################
####### GENERAL PARAMETERS ######
#################################
max_step = 20
amr.n_cell = 64 64 16
amr.max_grid_size = 16
amr.blocking_factor = 8
amr.max_level = 0
geometry.dims = 3
geometry.prob_lo = -4e-05 -4e-05 -2e-05 # physical domain
geometry.prob_hi = 4e-05 4e-05 2e-05

#################################
####### Boundary condition ######
#################################
boundary.field_lo = periodic periodic periodic
boundary.field_hi = periodic periodic periodic

#################################
############ NUMERICS ###########
#################################
warpx.serialize_initial_conditions = 0
warpx.do_dynamic_scheduling = 1
warpx.verbose = 1
warpx.cfl = 1.0

# Order of particle shape factors
algo.particle_shape = 3
algo.current_deposition = direct
algo.maxwell_solver = yee
algo.particle_pusher = boris
particles.do_tiling=true
# particles.tile_size=8 8 8
particles.tile_size=4 4 4
# particles.tile_size=32 16 16
warpx.sort_intervals=-1
warpx.sort_particles_for_deposition=false
warpx.grid_type=collocated
warpx.sort_bin_size=1 1 1

# 在输入文件中，可选
warpx.sort_interval      = 150  
warpx.min_sort_interval  = 100   
warpx.sort_trigger_rebuild_count  = 100
warpx.sort_trigger_empty_ratio  = 0.15
warpx.sort_trigger_full_ratio  = 0.85
warpx.sort_trigger_perf_enable  = 1
warpx.sort_trigger_perf_degrad  = 0.80
warpx.gap_ratio=0.2
warpx.rebuild_weight=1.5 # >1

#################################
############ PLASMA #############
#################################
particles.species_names = electrons

electrons.species_type = electron
electrons.injection_style = "NUniformPerCell"
electrons.num_particles_per_cell_each_dim = 4 4 4
electrons.profile = constant
electrons.density = 1.e25  # number of electrons per m^3
electrons.momentum_distribution_type = "gaussian"
electrons.ux_m  = 0.2
electrons.uy_m  = 0.2
electrons.uz_m  = 0.2
electrons.ux_th  = 0.2 # uth the std of the (unitless) momentum
electrons.uy_th  = 0.2 # uth the std of the (unitless) momentum
electrons.uz_th  = 0.2 # uth the std of the (unitless) momentum

# Diagnostics
diagnostics.enable = 0

# Tile pipeline Step3：三粒度统一时间线对比（BoundaryThenInner / DirectionalSeg / DirectionalCluster）
# 注意：当前 segmented/clustered push runner 只支持单线程执行，
# 运行时需要配合 OMP_NUM_THREADS=1。
# mode=3 表示：在 Step2 cluster 遍历基础上，为每个 boundary cluster 生成 mock 通信事件。
warpx.tile_pipeline_mode = 3
warpx.tile_pipeline_cluster_size = 4
warpx.tile_pipeline_respect_grid_boundary = 1
warpx.tile_pipeline_mock_comm = 1
warpx.tile_pipeline_verbose = 1
warpx.tile_pipeline_mock_alpha_us = 5.0
warpx.tile_pipeline_mock_bandwidth_gbps = 32.0
# validate 路径只做理论时间推演，不做真实 busy-wait 停顿。
warpx.tile_pipeline_mock_busy_wait = 0
warpx.tile_pipeline_print_event_summary = 1
# 开启三粒度统一对比摘要；三者输出字段完全对齐，便于直接比较。
warpx.tile_pipeline_compare_three_granularity = 1
# validate 理论 ready 步长（秒）：避免“每个 cluster 人为+1 秒”的失真时间轴。
warpx.tile_pipeline_validate_ready_step_s = 1.0e-6
